HOMELAB_IMAGE=ghcr.io/kombifyio/homelab-open-core
IMAGE_TAG=
HOMELAB_BIND=127.0.0.1
HOMELAB_PORT=5260
HOMELAB_GRPC_BIND=127.0.0.1
HOMELAB_GRPC_PORT=5263

# Generate the session secret and database password before first start.
# Keep all three secrets stable across restarts and preserve them with backups.
# openssl rand -hex 32
HOMELAB_V2_SESSION_SECRET=
POSTGRES_PASSWORD=

# Exactly 32 text bytes, used directly by AES-256-GCM (not base64-decoded).
# openssl rand -base64 24
HOMELAB_ENCRYPTION_KEY=

# Set the HTTPS origin exposed by your trusted reverse proxy.
HOMELAB_PUBLIC_ORIGIN=https://homelab.example.com
HOMELAB_CORS_ORIGINS=https://homelab.example.com
